@model List<Product>

@{
    ViewBag.Title = "List products";
}

@if (Model != null && Model.Count != 0)
{
@foreach (var p in Model)
    {
        <div class="card bg-dark text-white" style="width: 18rem;">
            <img src="@p.Image" class="card-img-top" alt="Product image">
            <div class="card-body">
                <h5 class="mb-4">@p.Name</h5>
                <p><strong>Date added: </strong>@p.DateCreation</p>
                <p><strong>Price: </strong>@p.Price</p>
            </div>
            <div class="card-body text-end">
                <a href="#" class="btn btn-light">Make order</a>
                <a asp-action="Details" asp-controller="Product" asp-route-productId="@p.Id" class="btn btn btn-outline-light m-lg-3">Details</a>
            </div>
        </div>
    }
}
else
{
    <h4 class="text-center">Unfortunately, there are currently no product for sale :c</h4>
    <p class="text-center mt-2"><a asp-action="Create" asp-controller="Product" class="btn btn-dark">Add new product</a></p>
}