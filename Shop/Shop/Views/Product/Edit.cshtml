@model Product

@{
    ViewBag.Title = "Edit Product";
}

<div class="bg-dark text-center pt-5 pb-4">
    <h3 class="text-white mb-5">Fill out the form edit product</h3>
    <form asp-action="Edit" asp-controller="Product" method="post">
        <input type="hidden" asp-for="Id"/>
        <div class="form_row mb-3">
            <label for="name" class="col-4">
                <input type="text" class="form-control" asp-for="Name" placeholder="Specify product name...">
            </label>
        </div>
        <div class="form_row mb-3">
            <label for="category" class="col-4">
                <select asp-for="CategoryId" class="form-control" asp-items="ViewBag.Categories">
                    <option value="">Select a category...</option>
                </select>
            </label>
        </div>
        <div class="form_row mb-3">
            <label for="brand" class="col-4">
                <select asp-for="BrandId" class="form-control" asp-items="ViewBag.Brands">
                    <option value="">Select a brand...</option>
                </select>
            </label>
        </div>
        <div class="form_row mb-3">
            <label for="image" class="col-4">
                <input type="text" class="form-control" asp-for="Image" placeholder="Enter the image link...">
            </label>
        </div>
        <div class="form_row mb-3">
            <label for="price" class="col-4">
                <input type="number" class="form-control" asp-for="Price" placeholder="Specify the product price...">
            </label>
        </div>
        <button type="submit" class="btn btn-outline-light mb-3 w-25">Save</button>
    </form>
</div>