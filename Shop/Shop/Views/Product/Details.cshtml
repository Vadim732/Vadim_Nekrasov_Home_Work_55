@model Product

@{
    ViewBag.Title = "Detailed view of the product";
}

<div class="bg-dark text-white pt-4 mt-5">
    <div class="row px-5">
        <div class="col-4 border-end border-white">
            <h4 class="text-center mb-5">Info</h4>
            <p><strong>Id: </strong>@Model.Id</p>
            <p><strong>Name: </strong>@Model.Name</p>
            <p><strong>Brand: </strong>@Model.Brand.Name</p>
            <p><strong>Category: </strong>@Model.Category.Name</p>
            <p><strong>Date added: </strong>@Model.DateCreation</p>
            @if (Model.DateUpdate != null)
            {
                <p><strong>Date edited: </strong>@Model.DateUpdate</p>
            }
            <p><strong>Price: </strong>@Model.Price</p>
            @* <p class="text-center mt-3"><a asp-action="Create" asp-controller="Order" asp-route-productId="@Model.Id" class="btn btn-outline-success w-50">Make order</a></p> *@
            <p class="text-center mt-2"><a asp-action="Index" asp-controller="Product" class="btn btn-outline-light w-50">To main page</a></p>
            @* <p class="text-center mt-2"><a asp-action="Delete" asp-controller="Product" asp-route-productId="@Model.Id" class="btn btn-outline-light w-50">Delete</a></p> *@
            @* <p class="text-center mt-2"><a asp-action="Edit" asp-controller="Product" asp-route-productId="@Model.Id" class="btn btn-outline-light w-50">Edit</a></p> *@
        </div>
        <div class="col-8 text-center">
            <img src="@Model.Image" class="img-fluid" alt="Product image">
        </div>
    </div>
</div>

